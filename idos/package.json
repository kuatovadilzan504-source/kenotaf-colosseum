    "@idosgames/wallet": "0.6.2",
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-solana": "1.8.23",
    "@reown/appkit-adapter-wagmi": "1.8.23",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/web3.js": "1.98.4",
    "@tanstack/react-query": "5.101.2",
    "buffer": "6.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "wagmi": "3.6.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
